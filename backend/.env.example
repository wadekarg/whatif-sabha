# ============================================================
# WhatIfSabha — API Keys
# You only need ONE key. Pick any provider below.
# You can also add keys through the browser UI (click the gear icon).
# ============================================================

# --- Pick ONE (or more) ---
ANTHROPIC_API_KEY=           # Claude — best quality (console.anthropic.com)
OPENAI_API_KEY=              # GPT-4o — reliable (platform.openai.com/api-keys)
GEMINI_API_KEY=              # Gemini Flash — free tier (aistudio.google.com/apikey)
GROQ_API_KEY=                # Llama 70B — free tier (console.groq.com/keys)
CEREBRAS_API_KEY=            # Qwen 235B — fastest (cloud.cerebras.ai)
NVIDIA_API_KEY=              # 91 free models (build.nvidia.com)

# --- Database (defaults work out of the box) ---
DATABASE_URL=sqlite+aiosqlite:///./whatif_sabha.db
REDIS_URL=redis://localhost:6379

# --- Upload ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# --- CORS ---
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Model config (defaults work, only change if you know what you're doing) ---
ANALYSIS_MODEL=gemini-3.1-flash-lite-preview
CHARACTER_AGENT_MODEL=qwen-3-235b-a22b-instruct-2507
JUDGE_MODEL=llama-3.3-70b-versatile
NARRATOR_MODEL=llama-3.3-70b-versatile
NVIDIA_JUDGE_MODEL=moonshotai/kimi-k2-instruct
NVIDIA_NARRATOR_MODEL=meta/llama-3.3-70b-instruct

# --- Optional: Character Soul Memory (Neo4j) ---
# Gives characters persistent memory across debates.
# Start Neo4j with: docker compose up neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=whatif_sabha

# --- Optional: LightRAG Causal Graph ---
# Builds a narrative causal graph during story analysis. Adds ~60s to upload.
ENABLE_LIGHTRAG=false
