GEMINI_API_KEY=REDACTED_GEMINI_KEY
GROQ_API_KEY=REDACTED_GROQ_KEY
CEREBRAS_API_KEY=REDACTED_CEREBRAS_KEY

DATABASE_URL=sqlite+aiosqlite:///./whatif_sabha.db
REDIS_URL=redis://localhost:6379

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# LLM model config
# Analysis: Gemini 3.1 Flash Lite — 1M context window, free, perfect for full story ingestion
# Character agents: Cerebras qwen-3-235b — 235B model, ultra-fast inference, 14.4K RPD
# Judge + Narrator: Groq llama-3.3-70b — best quality for evaluation and prose
ANALYSIS_MODEL=gemini-3.1-flash-lite-preview
CHARACTER_AGENT_MODEL=qwen-3-235b-a22b-instruct-2507
JUDGE_MODEL=llama-3.3-70b-versatile
NARRATOR_MODEL=llama-3.3-70b-versatile
