GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here   # optional — get free key at build.nvidia.com

DATABASE_URL=sqlite+aiosqlite:///./whatif_sabha.db
REDIS_URL=redis://localhost:6379

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# LLM model config
# Analysis: Gemini Flash — 1M context window, perfect for full story ingestion
# Character agents: Cerebras qwen-3-235b — ultra-fast inference
# Judge + Narrator: Groq llama-3.3-70b — best quality (auto-falls back to gemma2-9b-it → llama-3.1-8b-instant → NVIDIA on rate limits)
# NVIDIA fallback: set to your preferred model from build.nvidia.com (e.g. moonshotai/kimi or nvidia/llama-3.1-nemotron-70b-instruct)
ANALYSIS_MODEL=gemini-3.1-flash-lite-preview
CHARACTER_AGENT_MODEL=qwen-3-235b-a22b-instruct-2507
JUDGE_MODEL=llama-3.3-70b-versatile
NARRATOR_MODEL=llama-3.3-70b-versatile
NVIDIA_JUDGE_MODEL=moonshotai/kimi-k2-instruct      # primary judge — no daily token limit
NVIDIA_NARRATOR_MODEL=meta/llama-3.3-70b-instruct   # primary narrator — no daily token limit

# --- Character Soul Memory (Graphiti + Neo4j) ---
# Optional but highly recommended. Gives characters persistent memory across debates.
# Start Neo4j with: docker-compose up neo4j
# Or run standalone: docker run -p 7687:7687 -e NEO4J_AUTH=neo4j/whatif_sabha neo4j:5-community
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=whatif_sabha

# --- LightRAG Causal Graph ---
# Optional. Builds a narrative causal graph during story analysis.
# No extra keys needed — uses existing GROQ_API_KEY.
# Set to "true" to enable (adds ~60s to upload processing):
ENABLE_LIGHTRAG=false
